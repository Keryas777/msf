ame":"ultimate","spawns":[],"type":"ultimate","typeLabel":"Ultime","typeOrder":30},{"actions":[],"baseType":"passive","characterId":"IronPatriot","energy":null,"iconUrl":"https://assets.marvelstrikeforce.com/imgs/ICON_ABILITY_IRONPATRIOT_PASSIVE_f29b6d83.png","id":"abl_a4755f7311b67268","isEmpowered":false,"maxLevel":"5","mechanicsStatus":"available","mentions":[{"abilityId":"abl_a4755f7311b67268","abilityType":"passive","chance":null,"characterId":"IronPatriot","conditions":[],"evidence":"official_text_only","excerpt":"S'il y a au moins 2 alliés de la Cabale, les ennemis ne peuvent pas obtenir Furtivité","id":"txt_90d352372e198935","kind":"mention","kindLabel":"Mentions","mechanicId":"stealth","metrics":[],"modes":[],"sides":[],"target":null,"term":"Furtivité","trigger":null},{"abilityId":"abl_a4755f7311b67268","abilityType":"passive","chance":null,"characterId":"IronPatriot","conditions":[],"evidence":"official_text_only","excerpt":"À l'apparition, applique +1 fois Vulnérable à tous les ennemis, jusqu'à un maximum de 5. Ceci ne peut être ni bloqué ni esquivé. (Cet effet s'active après d'autres capacités passives À l'apparition.)","id":"txt_a1358eb287c38048","kind":"mention","kindLabel":"Mentions","mechanicId":"vulnerable","metrics":[],"modes":[],"sides":[],"target":null,"term":"Vulnérable","trigger":null}],"name":"Iron Osborn","officialText":"À l'apparition, applique +1 fois Vulnérable à tous les ennemis, jusqu'à un maximum de 5. Ceci ne peut être ni bloqué ni esquivé. (Cet effet s'active après d'autres capacités passives À l'apparition.)\n\nGagne Appui prêt à chaque tour des alliés de la Cabale. À chaque tour, donne Appui prêt à un allié de la Cabale aléatoire.\n\nLes ennemis avec Vulnérable subissent 10 % de dégâts supplémentaires par Vulnérable, jusqu'à un maximum de 30 %.\nS'il y a au moins 2 alliés de la Cabale, les ennemis ne peuvent pas obtenir Furtivité\n\nDonne +50 % de dégâts.\nGagne +50 % de focalisation. Applique aux alliés Super-vilains +50 % de focalisation.\n\nDans l'Épreuve :\n> Applique aux alliés Super-vilains +50 % de dégâts.\n> S'il y a au moins 2 alliés de la Cabale, ce personnage et tous les alliés Super-vilains gagnent +100 % de précision.\n> S'il y a au moins 2 alliés de la Cabale, la jauge de vitesse des ennemis avec Vulnérable ne peut pas se remplir (cela ne s'applique pas au gain normal de jauge de vitesse).\n> Aux coups critiques des alliés Super-vilains, applique +1 fois Vulnérable à tous les ennemis, jusqu'à un maximum de 5.","operations":[{"abilityId":"abl_a4755f7311b67268","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"IronPatriot","conditions":[],"effect":{"label":"Assist Now","mechanicId":"assist-now","resolved":true,"sourceName":"AssistNow"},"evidence":"normalized","id":"op_397eca34bb8ab12c","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["assist-now"],"metrics":[],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié · cible aléatoire","trigger":"À chaque tour"},{"abilityId":"abl_a4755f7311b67268","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"IronPatriot","conditions":[],"effect":{"label":"Assist Now","mechanicId":"assist-now","resolved":true,"sourceName":"AssistNow"},"evidence":"normalized","id":"op_62c5ae740d94f714","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["assist-now"],"metrics":[],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_a4755f7311b67268","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"IronPatriot","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Marked","mechanicId":"marked","resolved":true,"sourceName":"Marked"},"evidence":"normalized","id":"op_1f0c10c8b4928081","kind":"effect_duration_modify","kindLabel":"Modifie la durée","mechanicIds":["marked"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"delta","label":"Vari