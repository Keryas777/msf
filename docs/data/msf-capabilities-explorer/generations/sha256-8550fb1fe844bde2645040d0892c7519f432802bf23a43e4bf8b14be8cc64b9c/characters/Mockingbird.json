s/ICON_ABILITY_MOCKINGBIRD_PASSIVE_ce083514.png","id":"abl_02dcd15fe1140867","isEmpowered":false,"maxLevel":"5","mechanicsStatus":"available","mentions":[],"name":"Tacticienne","officialText":"À l'apparition, donne Attaque augmentée pendant 2 tours.\n\nQuand soi ou un allié non invoqué des Nouveaux Avengers ou du S.H.I.E.L.D. passe sous 50 % de vie, invoque 1 soldat du S.H.I.E.L.D. et lui applique Défense augmentée et Indestructible. Si l'allié est des Nouveaux Avengers, lui applique 1 fois Furtivité jusqu'à un maximum de 2.\n\nÀ la fin de n'importe quel tour, si soi ou un allié Nouvel Avenger a Furtivité et au moins 75 % de vie, lui supprime Furtivité et remplit sa jauge de vitesse de 10 % + 10 % par allié non invoqué.\n\nDonne +15 % de vie max. et +15 % aux alliés Nouveaux Avengers\n\nEn guerre :\n> Applique Provocation au soldat du S.H.I.E.L.D. invoqué.\n> Applique +40 % de vie max. à l'infirmière et au soldat du S.H.I.E.L.D. invoquées.\n> Applique +30 % de dégâts à l'infirmière et au soldat du S.H.I.E.L.D. invoquées.","operations":[{"abilityId":"abl_02dcd15fe1140867","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Mockingbird","conditions":[],"effect":{"label":"Attaque augmentée","mechanicId":"offense-up","resolved":true,"sourceName":"OffenseUp"},"evidence":"normalized","id":"op_898f25ae6503607a","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["offense-up"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_02dcd15fe1140867","abilityType":"passive","actionOrder":1,"chance":100,"characterId":"Mockingbird","conditions":[],"effect":{"label":"Défense augmentée","mechanicId":"defense-up","resolved":true,"sourceName":"DefenseUp"},"evidence":"normalized","id":"op_1ee3ae98aa517b4d","kind":"effect_apply","kindLabel":