rce.com/imgs/ICON_ABILITY_BLACKCAT_PASSIVE_3f44e67e.png","id":"abl_d48cfbf200038e78","isEmpowered":false,"maxLevel":"6","mechanicsStatus":"available","mentions":[{"abilityId":"abl_d48cfbf200038e78","abilityType":"passive","chance":null,"characterId":"BlackCat","conditions":[],"evidence":"official_text_only","excerpt":"Au début du combat, les ennemis biotechniques ne peuvent pas apparaître avec Vitesse augmentée.","id":"txt_1da1dee2ef9d3548","kind":"mention","kindLabel":"Mentions","mechanicId":"speed-up","metrics":[],"modes":[],"sides":[],"target":null,"term":"Vitesse augmentée","trigger":null},{"abilityId":"abl_d48cfbf200038e78","abilityType":"passive","chance":null,"characterId":"BlackCat","conditions":[],"evidence":"official_text_only","excerpt":"Par Indestructible sur soi, donne +10 % d'armure, +10 % de chances de contre-attaque, +10 % de focalisation et +10 % de résistance.","id":"txt_27be135ce2b9fe7b","kind":"mention","kindLabel":"Mentions","mechanicId":"counter","metrics":[],"modes":[],"sides":[],"target":null,"term":"Contre-attaque","trigger":null}],"name":"Neuf vies","officialText":"Au début du combat, les ennemis biotechniques ne peuvent pas apparaître avec Vitesse augmentée.\n\nÀ l'apparition :\n> Donne 3 fois Chargé, 9 fois Indestructible et Immunité.\n> En arène, donne Sauvegarde à soi et aux alliés Défenseurs secrets.\n> Supprime Ressusciter une fois de tous les ennemis. +1 000 % de focalisation pour cette action. Si un ennemi avait Ressusciter une fois, le donne à soi.\n\nÀ n'importe quel tour, avec au moins 5 fois Chargé :\n> Supprime les effets nuisibles et rend 30 % de vie.\n> Remplit la jauge de vitesse de 30 %.\n> Donne 1 fois Sauvegarde jusqu'à un maximum de 2 et retire 5 fois Chargé.\n\nAvec Indestructible, empêche de réduire la jauge de vitesse de soi et des alliés Défenseurs secrets.\nPar Indestructible sur soi, donne +10 % d'armure, +10 % de chances de contre-attaque, +10 % de focalisation et +10 % de résistance.\nDonne +50 % de vie max.\nApplique aux alliés Défenseurs secrets et Spider-Man +50 % de vie max.\n\nEn attaque d'arène :\n> Les ennemis ne peuvent pas apparaître avec Indestructible.\n> Réduit la réduction des dégâts des ennemis n'ayant pas Indestructible de 15 %.","operations":[{"abilityId":"abl_d48cfbf200038e78","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"BlackCat","conditions":[],"effect":{"label":"Dernier souffle","mechanicId":"deathproof","resolved":true,"sourceName":"Deathproof"},"evidence":"normalized","id":"op_62aea5718317a8f7","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["deathproof"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":9}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_d48cfbf200038e78","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"BlackCat","conditions":["Condition d’exclusion présente"],"effect":{"label":"Binary","mechanicId":"binary","resolved":true,"sourceName":"Binary"},"evidence":"normalized","id":"op_85178ab84847db34","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["binary"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_d48cfbf200038e78","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"BlackCat","conditions":[],"effect":{"label":"Chargé","mechanicId":"charged","resolved":true,"sourceName":"Charged"},"evidence":"normalized","id":"op_afcb0b8b26b73f9b","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["charged"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":3}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":