ros asgardiens.\n\nEn défense de guerre :\n> À l'apparition, donne Défense augmentée pendant 2 tours à soi et aux alliés asgardiens.\n> Quand soi ou un allié héros asgardien passe sous 50 % de vie, lui applique 2 fois Indestructible et Vitesse augmentée pendant 2 tours.","operations":[{"abilityId":"abl_847890461c8cbf39","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"Heimdall","conditions":["Contexte : Défense","Mode : Guerre"],"effect":{"label":"Défense augmentée","mechanicId":"defense-up","resolved":true,"sourceName":"DefenseUp"},"evidence":"normalized","id":"op_070b3e57f46402c8","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["defense-up","war-defense"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Défense"],"sourceType":"proc","target":"allié · cible aléatoire · jusqu’à 10","trigger":"Au début du combat"},{"abilityId":"abl_847890461c8cbf39","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Heimdall","conditions":["Contexte : Défense","Mode : Guerre"],"effect":{"label":"Dernier souffle","mechanicId":"deathproof","resolved":true,"sourceName":"Deathproof"},"evidence":"normalized","id":"op_633e4515269343f2","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["deathproof","war-defense"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Défense"],"sourceType":"proc","target":null,"trigger":"Sous un seuil de vie"},{"abilityId":"abl_847890461c8cbf39","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Heimdall","conditions":["Contexte : Défense","Mode : Guerre"],"effect":{"label":"Vitesse augmentée","mechanicId":"speed-up","resolved":true,"sourceName":"SpeedUp"},"evidence":"normalized","id":"op_cc920d81d25be283","kind":"effect_apply","kindLabel":"Applique","mec