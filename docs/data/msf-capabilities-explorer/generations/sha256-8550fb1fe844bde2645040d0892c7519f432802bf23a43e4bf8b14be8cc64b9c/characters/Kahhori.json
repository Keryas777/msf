.\n\nApplique +1 fois Chargé, jusqu’à un maximum de 3, à l’alliée Ms. Marvel (Classique) ou Guêpe ayant le plus de vie.\n\nProlonge la durée de 1 effet bénéfique sur ce personnage de +1, jusqu'à un maximum de 2.\n\nLors d'une attaque forcée contre un allié, inflige moins de dégâts, ne convertit aucun effet bénéfique, n'applique aucun effet nuisible et n'applique pas Exposé aux personnages d’A-Force Absolute.\n\nL'attaque ne peut pas recevoir d’appui ni être bloquée ou contrée.","operations":[{"abilityId":"abl_601b6e277a237055","abilityType":"basic","actionOrder":5,"chance":100,"characterId":"Kahhori","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Précision réduite","mechanicId":"accuracy-down","resolved":true,"sourceName":"AccuracyDown"},"evidence":"normalized","id":"op_8cb5cf703b7afc98","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["accuracy-down"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"ennemi","trigger":null},{"abilityId":"abl_601b6e277a237055","abilityType":"basic","actionOrder":6,"chance":100,"characterId":"Kahhori","conditions":["Condition d’exclusion présente"],"effect":{"label":"À découvert","mechanicId":"exposed","resolved":true,"sourceName":"Exposed"},"evidence":"normalized","id":"op_8ec6fb6154f91016","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["exposed"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"ennemi","trigger":null},{"abilityId":"abl_601b6e277a237055","abilityType":"basic","actionOrder":7,"chance":100,"characterId":"Kahhori","conditions":[],"effect":{"label":"Chargé","mechanicId":"charged","resolved":true,"sourceName":"Charged"},"evidence":"norm