ce et +40 % aux alliés d'Arme X.\nDonne +10 % de chances d'appui + 10 % par allié d'Arme X.\nS'il y a 4 ou plus alliés d'Arme X, réduit les chances d'appui des ennemis de 25 %.\n\nEn guerre :\n> À l'apparition, donne 5 fois Chargé jusqu'à un maximum de 5.\n> Donne +40 % de dégâts perforants par Chargé.\n> Réduit les chances d'appui des ennemis de 100 % à la place.","operations":[{"abilityId":"abl_52a67487e2859662","abilityType":"passive","actionOrder":1,"chance":null,"characterId":"SilverSamurai","conditions":["Condition structurée supplémentaire"],"effect":null,"evidence":"normalized","id":"op_1f74a42f4763f8e0","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["generic-debuffs"],"metrics":[{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_52a67487e2859662","abilityType":"passive","actionOrder":3,"chance":null,"characterId":"SilverSamurai","conditions":["Condition structurée supplémentaire"],"effect":null,"evidence":"normalized","id":"op_f4112bef8b91c637","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["generic-debuffs"],"metrics":[{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_52a67487e2859662","abilityType":"passive","actionOrder":5,"chance":null,"characterId":"SilverSamurai","conditions":["Condition structurée supplémentaire"],"effect":null,"evidence":"normalized","id":"op_23be3c2f3fa7cadf","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["generic-debuffs"],"metrics":[{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié","trigger":"À chaque tour"},{"abili