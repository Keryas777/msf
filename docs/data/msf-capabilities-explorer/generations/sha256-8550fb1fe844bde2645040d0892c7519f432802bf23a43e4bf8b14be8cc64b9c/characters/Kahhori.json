ir Ralentissement.\n\nLa focalisation et les dégâts de ce personnage ne peuvent être réduites que par Attaque réduite.\n\nPour les ennemis ayant Exposé :\n> En guerre, s'il y a au moins 4 alliés de l’A-Force Absolute, ils ne peuvent pas remplir leur jauge de vitesse ou celle de leurs alliés (cela ne s'applique pas au gain normal de jauge de vitesse).\n> En guerre, ils ne peuvent pas obtenir Furtivité ou Chargé. Cela n'empêche pas de prolonger des effets déjà sur la cible.\n> En guerre, ils ne peuvent pas appliquer une Barrière sur eux ou leurs alliés.\n> En guerre, leurs chances d'appui sont réduites de 100 %.\n> Leurs chances de ressusciter sont réduites de 100 %.","operations":[{"abilityId":"abl_6a63ef2c6be1fe56","abilityType":"passive","actionOrder":2,"chance":null,"characterId":"Kahhori","conditions":[],"effect":{"label":"À découvert","mechanicId":"exposed","resolved":true,"sourceName":"Exposed"},"evidence":"normalized","id":"op_54a80e1c75f8bfa9","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["exposed"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":null,"trigger":"Au début du combat"}],"parentAbilityId":null,"presentationStatus":"official","relatedMechanics":[{"id":"action-stat-modifier","kind":"detected_action","label":"Modification de statistique"},{"id":"action-turn-meter","kind":"detected_action","label":"Modification de jauge de vitesse"},{"id":"charged","kind":"effect","label":"Chargé"},{"id":"exposed","kind":"effect","label":"À découvert"},{"id":"offense-down","kind":"effect","label":"Attaque réduite"},{"id":"slow","kind":"effect","label":"Ralentissement"},{"id":"stealth","kind":"effect","label":"Furtivité"}],"sourceName":"passive","spawns":[],"type":"passive","typeLabel":"Passive","typeOrder":40}],"artifactType":"codex_character_shard","character":{"displayTraits":["Absolute A Force","Contrôleur","Cosmique","Héros","Mystique","SP