conUrl":"https://assets.marvelstrikeforce.com/imgs/ICON_ABILITY_PETERBPARKER_PASSIVE_dee9fdd7.png","id":"abl_5e1934914612c8e6","isEmpowered":false,"maxLevel":"5","mechanicsStatus":"available","mentions":[{"abilityId":"abl_5e1934914612c8e6","abilityType":"passive","chance":null,"characterId":"PeterBParker","conditions":[],"evidence":"official_text_only","excerpt":"Si le personnage attaqué avait Vulnérable, supprime Vulnérable de ce personnage et de tous les alliés de la Société des araignées.","id":"txt_0402ae891fd80002","kind":"mention","kindLabel":"Mentions","mechanicId":"vulnerable","metrics":[],"modes":[],"sides":[],"target":null,"term":"Vulnérable","trigger":null},{"abilityId":"abl_5e1934914612c8e6","abilityType":"passive","chance":null,"characterId":"PeterBParker","conditions":[],"evidence":"official_text_only","excerpt":"Si ce personnage a 3 ou plus d’alliés de la Société des araignées, ce personnage et les alliés de la Société des araignées ne peuvent pas obtenir Défense réduite.","id":"txt_9fee989f586a1713","kind":"mention","kindLabel":"Mentions","mechanicId":"defense-down","metrics":[],"modes":[],"sides":[],"target":null,"term":"Défense réduite","trigger":null}],"name":"Bébé à bord","officialText":"À l'apparition :\n> Applique +2 Indestructible, +2 Défense augmentée, +2 Déviation et +2 Régénération à soi-même et à tous les alliés héros du Spider-Verse.\n> En raid, applique +1 Sauvegarde à soi-même et à tous les alliés de la Société des araignées.\n\nÀ chaque tour, prolonge la durée de tous les effets bénéfiques de 1 sur l'allié héros du Spider-Verse ayant le moins de vie, puis applique Appui prêt sur l'allié héros du Spider-Verse ayant le plus de dégâts.\n\nLorsque ce personnage ou un allié Héros du Spider-Verse est attaqué :\n> Soigne l’allié Héros du Spider-Verse le plus blessé ou soi-même pour 20 % de la vie max. de ce personnage.\n> Si le personnage attaqué avait Vulnérable, supprime Vulnérable de ce personnage et de tous les alliés de la Société des araignées.\n\nObtient +10 % de chance d'appui + 10 % par allié de la Société des araignées.\nObtient +50 % de la vie max. et +50 % de résistance pour soi et tous les alliés de la Société des araignées.\n\nEn raid :\nObtient +100 % de résistance supplémentaire à soi-même et à tous les alliés de la Société des araignées.\nSi ce personnage a 3 ou plus d’alliés de la Société des araignées, ce personnage et les alliés de la Société des araignées ne peuvent pas obtenir Défense réduite.","operations":[{"abilityId":"abl_5e1934914612c8e6","abilityType":"passive","actionOrder":1,"chance":100,"characterId":"PeterBParker","conditions":[],"effect":{"label":"Assist Now","mechanicId":"assist-now","resolved":true,"sourceName":"AssistNow"},"evidence":"normalized","id":"op_7277c557c2d71410","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["assist-now"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié · cible ayant la statistique la plus élevée · jusqu’à 1","trigger":"À chaque tour"},{"abilityId":"abl_5e1934914612c8e6","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"PeterBParker","conditions":[],"effect":{"label":"Marked","mechanicId":"marked","resolved":true,"sourceName":"Marked"},"evidence":"normalized","id":"op_247cccfec264df93","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["marked"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié · cible aléatoire · jusqu’à 10","trigger":"Lorsqu’il est attaqué"},{"abilityId":"abl_5e1934914612c8e6","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"PeterBParker","conditions":[],"effect":{"label":"Déviation","mechan