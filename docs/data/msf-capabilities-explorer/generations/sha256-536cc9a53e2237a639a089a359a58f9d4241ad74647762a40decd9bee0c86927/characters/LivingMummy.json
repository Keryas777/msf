se.","operations":[{"abilityId":"abl_95aa13c4bb51d915","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"LivingMummy","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Provocation","mechanicId":"taunt","resolved":true,"sourceName":"Taunt"},"evidence":"normalized","id":"op_a37b34b9794b0818","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["taunt"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_95aa13c4bb51d915","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"LivingMummy","conditions":[],"effect":{"label":"Contre-attaque","mechanicId":"counter","resolved":true,"sourceName":"Counter"},"evidence":"normalized","id":"op_d58f25472fa4d233","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["counter"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_95aa13c4bb51d915","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"LivingMummy","conditions":[],"effect":null,"evidence":"normalized","id":"op_2ba7fd56fd4f1373","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["generic-debuffs"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié · cible aléatoire · jusqu’à 10","trigger":"À la résurrection"},{"abilityId":"abl_95aa13c4bb51d915","abilityType":"passive","actionOrder":1,"chance":100,"characterId":"LivingMummy","conditions":[],"effect":{"label":"Ressusciter une fois","mechanicId":"revive-once","resolved":true,"sourceName":"ReviveOnce"},"evidence":"normalized","id":"op_bda2361e91