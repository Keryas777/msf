gmentée, est inévitable et ne peut pas être bloquée ou subir de contre-attaque.\n\nTénacité des morts-vivants :\n> Au tour de ce personnage ou d'un allié, ce personnage obtient +2 fois Déviation, jusqu'à un maximum de 5.\n> Les ennemis ne peuvent pas utiliser l’appui passif.\n> Ce personnage et tous les alliés obtiennent +10 % de dégâts, jusqu'à un maximum de 50 %, par ennemi avec Exposé.\n> Cet effet de bataille ne peut pas être supprimé ou remplacé par un autre effet de bataille et dure jusqu'à ce que 14 personnages, alliés et ennemis aient terminé leurs tours.","operations":[{"abilityId":"abl_3643a160ee4bd25d","abilityType":"special","actionOrder":2,"chance":100,"characterId":"ZombieKestrel","conditions":["Contexte : Attaque","Mode : Guerre","Nombre de cibles supérieur ou égal à 3","Traits : Undying"],"effect":{"label":"Silence","mechanicId":"silence","resolved":true,"sourceName":"Silence"},"evidence":"normalized","id":"op_dd85938271445a14","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["silence"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":"ennemi · cible aléatoire · jusqu’à 10","trigger":null},{"abilityId":"abl_3643a160ee4bd25d","abilityType":"special","actionOrder":7,"chance":100,"characterId":"ZombieKestrel","conditions":["Condition d’exclusion présente"],"effect":{"label":"Ressusciter une fois","mechanicId":"revive-once","resolved":true,"sourceName":"ReviveOnce"},"evidence":"normalized","id":"op_b7338a3ff7d9ee65","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["revive-once"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":null},{"abilityId":"abl_3643a160ee4b