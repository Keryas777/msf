rre, applique Évitement à ce personnage.\n\nLorsque le mode Anti-son est activé : réduit l’armure des ennemis de 20 %.\nEn mode Furtivité : obtient +20 % de chances d’esquive.\nDonne +50 % de vie max.\nDonne +150 % de focalisation.\nEn défense de guerre :\n> Les alliés Infestation obtiennent +50 % de vie max.\n> Les alliés Infestation obtiennent +150 % de focalisation.\n> Toute jauge de vitesse générée par un ennemi manipulateur est réduite de 50 %.","operations":[{"abilityId":"abl_5693f6a0dee64745","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"SpiderManBigTime","conditions":[],"effect":{"label":"Binary","mechanicId":"binary","resolved":true,"sourceName":"Binary"},"evidence":"normalized","id":"op_1f563efe7f6f1ca5","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["binary"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_5693f6a0dee64745","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"SpiderManBigTime","conditions":[],"effect":{"label":"Furtivité","mechanicId":"stealth","resolved":true,"sourceName":"Stealth"},"evidence":"normalized","id":"op_6579cd0abd74489b","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["stealth"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":null,"trigger":"Sous un seuil de vie"},{"abilityId":"abl_5693f6a0dee64745","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"SpiderManBigTime","conditions":["Contexte : Défense","Mode : Guerre","Nombre de cibles supérieur ou égal à 4","Traits : Infestation"],"effect":{"label":"Chargé","mechanicId":"charged","resolved":true,"source