588fc41051e2f4","kind":"detected","kindLabel":"Actions détectées","label":"Soin","mechanicId":"action-heal","metrics":[],"modes":[],"sides":[],"sourceType":"heal","target":null,"trigger":null},{"abilityId":"abl_4c65ca6a0857a1c5","abilityType":"passive","chance":null,"characterId":"Ikaris","conditions":[],"evidence":"preserved_uninterpreted","id":"act_9760d726c9654dda","kind":"detected","kindLabel":"Actions détectées","label":"Soin","mechanicId":"action-heal","metrics":[],"modes":[],"sides":[],"sourceType":"heal","target":null,"trigger":null}],"baseType":"passive","characterId":"Ikaris","energy":null,"iconUrl":"https://assets.marvelstrikeforce.com/imgs/ICON_ABILITY_IKARIS_PASSIVE_96c8d6b8.png","id":"abl_4c65ca6a0857a1c5","isEmpowered":false,"maxLevel":"5","mechanicsStatus":"available","mentions":[{"abilityId":"abl_4c65ca6a0857a1c5","abilityType":"passive","chance":null,"characterId":"Ikaris","conditions":[],"evidence":"official_text_only","excerpt":"À chaque tour, sans Étourdissement, supprime Blocage de capacité et 1 effet nuisible aléatoire de soi, des Circé alliées et de l'allié ayant perdu le plus de vie.","id":"txt_a6f6b4bdb434f270","kind":"mention","kindLabel":"Mentions","mechanicId":"stun","metrics":[],"modes":[],"sides":[],"target":null,"term":"Étourdissement","trigger":null}],"name":"Leader éternel","officialText":"Si la vie est au max. au début du combat, la première fois que ce personnage passe sous 40 % de vie, supprime tous les effets nuisibles de soi et rend 60 % de la vie max. de ce personnage.\n\nÀ l'apparition, donne Attaque augmentée pendant 2 tours à soi et aux alliés éternels. En Arène ou dans la Dimension Noire, applique à la place Attaque augmentée pendant 2 tours à soi et à tous les alliés.\n\nÀ chaque tour, sans Étourdissement, supprime Blocage de capacité et 1 effet nuisible aléatoire de soi, des Circé alliées et de l'allié ayant perdu le plus de vie.\nÀ chaque tour, sans Étourdissement, donne Défense augmentée pendant 2 tours + Vitesse augmentée pour 2 tours puis choisit 1 ennemi aléatoire avec Indestructible. Supprime Indestructible de cet ennemi, et applique +1 fois Indestructible jusqu'à un maximum de 5 à soi et aux alliés Éternels.\nÀ chaque tour, si Circé est parmi les alliés, rend 15 % de la vie max. de ce personnage.\n\nDonne +30 % d'armure. Les Circé alliées reçoivent +30 % d'armure.\nDonne +50 % de Résistance. Les Circé alliées reçoivent +50 % de Résistance.\nEn Arène ou la Dimension Noire, donne +25 % de dégâts. Les Circé alliées reçoivent +25 % de dégâts.","operations":[{"abilityId":"abl_4c65ca6a0857a1c5","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"Ikaris","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Attaque augmentée","mechanicId":"offense-up","resolved":true,"sourceName":"OffenseUp"},"evidence":"normalized","id":"op_2b6712b9def461db","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["offense-up"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié · cible aléatoire · jusqu’à 10","trigger":"Au début du combat"},{"abilityId":"abl_4c65ca6a0857a1c5","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"Ikaris","conditions":["Condition d’exclusion présente"],"effect":{"label":"Attaque augmentée","mechanicId":"offense-up","resolved":true,"sourceName":"OffenseUp"},"evidence":"normalized","id":"op_84374346de1df547","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["offense-up"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié · cible aléatoire · jusqu’à 10","trigger":"Au début du combat"},{"abilityId":"abl_4c65ca6a0857a1c5","abilityType":"passive","actionOrder":1,"chance":null,"characterId":"Ikaris","conditions":["Vie du personnage supérieur ou égal à 99 %"],"effect":{"label":"Invisi