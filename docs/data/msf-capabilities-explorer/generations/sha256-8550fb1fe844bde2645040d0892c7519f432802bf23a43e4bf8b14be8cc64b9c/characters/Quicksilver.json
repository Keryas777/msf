augmentée et 2 fois Indestructible.\n\nÀ la mort, applique Évitement à un Hawkeye allié.\n\nDonne 50 % de vie max. et +30 % à Sorcière Rouge alliée.\nDonne +100 % de focalisation par Chargé.","operations":[{"abilityId":"abl_14a050b43cf884d5","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Quicksilver","conditions":[],"effect":{"label":"Contre-attaque","mechanicId":"counter","resolved":true,"sourceName":"Counter"},"evidence":"normalized","id":"op_089ee8e2abab8bd9","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["counter"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2},{"key":"applyCount","label":"Nombre d’applications","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_14a050b43cf884d5","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Quicksilver","conditions":[],"effect":{"label":"Déviation","mechanicId":"deflect","resolved":true,"sourceName":"Deflect"},"evidence":"normalized","id":"op_1fc148a50567c173","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["deflect"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2},{"key":"applyCount","label":"Nombre d’applications","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_14a050b43cf884d5","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Quicksilver","conditions":[],"effect":{"label":"Vitesse augmentée","mechanicId":"speed-up","resolved":true,"sourceName":"SpeedUp"},"evidence":"normalized","id":"op_5d3b002cc8437f4b","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["speed-up"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"ke