}}}],"baseType":"passive","characterId":"ZombieJuggernaut","energy":null,"iconUrl":"https://assets.marvelstrikeforce.com/imgs/ICON_ABILITY_ZOMBIEJUGGERNAUT_PASSIVE_5c540d66.png","id":"abl_a5d5ba153bdb0412","isEmpowered":false,"maxLevel":"5","mechanicsStatus":"available","mentions":[{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","chance":null,"characterId":"ZombieJuggernaut","conditions":[],"evidence":"official_text_only","excerpt":"Avec au moins 50 % de vie, empêche les ennemis d'obtenir Vitesse augmentée.","id":"txt_5147d11c638b54d9","kind":"mention","kindLabel":"Mentions","mechanicId":"speed-up","metrics":[],"modes":[],"sides":[],"target":null,"term":"Vitesse augmentée","trigger":null},{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","chance":null,"characterId":"ZombieJuggernaut","conditions":[],"evidence":"official_text_only","excerpt":"Il n'est pas possible d'appliquer Étourdissement à ce personnage.","id":"txt_58094cad49b42443","kind":"mention","kindLabel":"Mentions","mechanicId":"stun","metrics":[],"modes":[],"sides":[],"target":null,"term":"Étourdissement","trigger":null}],"name":"Élan des morts-vivants","officialText":"À l’apparition, donne Provocation.\n\nÀ chaque attaque subie, avec Chargé, remplit la jauge de vitesse de 30 % + 5 % par allié Impérissable.\n\nAu passage sous 50 % de vie, supprime Provocation et Blocage de soins, donne 2 fois Indestructible jusqu'à un maximum de 3 et applique Provocation à un Asgardien mort-vivant allié.\n\nQuand un allié Impérissable est invoqué ou ressuscité, donne 1 fois Chargé jusqu'à un maximum de 5. À la mort, avec au moins 5 fois Chargé, ressuscite avec 50 % de vie + 10 % par allié Impérissable non invoqué. Puis retire 5 fois Chargé.\n\nIl n'est pas possible d'appliquer Étourdissement à ce personnage.\nDonne +100 % de résistance, et +100 % aux alliés Impérissables.\nDonne +30 % de dégâts par Chargé.\n\nEn attaque de guerre :\n> À l'apparition, donne 2 fois Chargé.\n> Donne +10 % de drain de vie par Chargé.\n> Avec au moins 50 % de vie, réduit la résistance des ennemis de 75 %.\n> Avec au moins 50 % de vie, empêche les ennemis d'obtenir Vitesse augmentée.","operations":[{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"ZombieJuggernaut","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Chargé","mechanicId":"charged","resolved":true,"sourceName":"Charged"},"evidence":"normalized","id":"op_2e10161c9e1fef0a","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["charged"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"ZombieJuggernaut","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Provocation","mechanicId":"taunt","resolved":true,"sourceName":"Taunt"},"evidence":"normalized","id":"op_503441426c92a970","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["taunt"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"ZombieJuggernaut","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Provocation","mechanicId":"taunt","resolved":true,"sourceName":"Taunt"},"evidence":"normalized","id":"op_6aee4231e6522733","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["taunt"],"metrics":[],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié","trigger":"Sous un seuil de vie"},{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","actionOrder":0,"chance":nu