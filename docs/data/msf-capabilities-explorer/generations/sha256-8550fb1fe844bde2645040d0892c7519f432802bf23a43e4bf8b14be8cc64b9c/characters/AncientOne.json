 que ce personnage a Contre, réduit les chances de critique des ennemis de 50 %.\n\nDonne +100 % de chances de contre-attaque.\nDonne +25 % de dégâts critiques. Sur Battleworld, donne +25 % de dégâts critiques aux alliés astraux.\nDonne +25 % de chances de critique. Sur Battleworld, donne +25 % de chances de critique aux alliés astraux.\n\nLa focalisation de ce personnage et des alliés astraux ne peut être réduite que par Attaque réduite.","operations":[{"abilityId":"abl_f1c4b100f888e7e8","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"AncientOne","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Possessed Tracking","mechanicId":"possessed-tracking","resolved":true,"sourceName":"PossessedTracking"},"evidence":"normalized","id":"op_6653942111d6f95b","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["possessed-tracking"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1},{"key":"applyCount","label":"Nombre d’applications","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié · cible aléatoire · jusqu’à 1","trigger":"À la mort"},{"abilityId":"abl_f1c4b100f888e7e8","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"AncientOne","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Possessed","mechanicId":"possessed","resolved":true,"sourceName":"Possessed"},"evidence":"normalized","id":"op_6cfb6a8bb947c57a","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["possessed"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1},{"key":"applyCount","label":"Nombre d’applications","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié · cible aléatoire · jusqu’à 1","trigger":"À la mort"},{"abilityId":"a