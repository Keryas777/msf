osé est attaqué, génère 1 énergie(s) de capacité pour soi ou pour 2 alliés qui n'étaient pas au maximum au début du tour.\n\nEn arène :\n> Les ennemis ne peuvent pas obtenir Immunité.\n> Ce personnage et ses alliés Annihilateurs ne peuvent pas obtenir Traumatisme.","operations":[{"abilityId":"abl_122dddb9edc6b92b","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"ThanosEndgame","conditions":[],"effect":{"label":"Invisible Non Binary","mechanicId":"invisible-non-binary","resolved":true,"sourceName":"InvisibleNonBinary"},"evidence":"normalized","id":"op_130f5f55a6fa0c68","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["invisible-non-binary"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":100}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_122dddb9edc6b92b","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"ThanosEndgame","conditions":[],"effect":{"label":"Invisible Non Binary","mechanicId":"invisible-non-binary","resolved":true,"sourceName":"InvisibleNonBinary"},"evidence":"normalized","id":"op_2a3312e75fa480aa","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["invisible-non-binary"],"metrics":[{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":999}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié","trigger":"Sous un seuil de vie"},{"abilityId":"abl_122dddb9edc6b92b","abilityType":"passive","actionOrder":1,"chance":null,"characterId":"ThanosEndgame","conditions":[],"effect":null,"evidence":"normalized","id":"op_b5e57b63f3878fdb","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["generic-debuffs"],"metrics":[{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":999}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié · cible aléatoire