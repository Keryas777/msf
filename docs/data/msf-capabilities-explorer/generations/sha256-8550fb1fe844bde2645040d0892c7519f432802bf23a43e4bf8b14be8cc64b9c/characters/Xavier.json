ication psionique","officialText":"Convertit Attaque réduite sur soi.\n\nSupprime la barrière de tous les ennemis. Réduit la durée de tous les effets bénéfiques de tous les ennemis de 2.\n\nAttaque tous les ennemis qui sont à moins de 25 % de vie pour 25 % de la vie max. de la cible. Ignore Indestructible et les capacités passives déclenchées au passage sous un montant de vie.\n\nAttaque tous les autres ennemis pour 750 % de dégâts perforants. Ces dégâts réduisent la vie max. de la cible de la même valeur.\n\nLes personnages tués par cette attaque ne peuvent pas être ressuscités. L’attaque est inévitable et ne peut pas être bloquée ou contrée.","operations":[{"abilityId":"abl_b80b3d12e2713e82","abilityType":"ultimate","actionOrder":2,"chance":null,"characterId":"Xavier","conditions":[],"effect":null,"evidence":"normalized","id":"op_47c6a594dcc29bb2","kind":"effect_duration_modify","kindLabel":"Modifie la durée","mechanicIds":["generic-buffs"],"metrics":[{"key":"delta","label":"Variation de durée","unit":null,"value":-2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_duration","target":null,"trigger":null},{"abilityId":"abl_b80b3d12e2713e82","abilityType":"ultimate","actionOrder":0,"chance":100,"characterId":"Xavier","conditions":[],"effect":{"label":"Attaque réduite","mechanicId":"offense-down","resolved":true,"sourceName":"OffenseDown"},"evidence":"normalized","id":"op_d5e500724a473d0f","kind":"effect_flip","kindLabel":"Retourne","mechanicIds":["offense-down"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":100}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_flip","target":"allié","trigger":null}],"parentAbilityId":null,"presentationStatus":"official","relatedMechanics":[{"id":"action-health-redistribute","kind":"detected_action","label":"Redistribution de vie"},{"id":"action-stat-modifier","kind":"detected_action