it la jauge de vitesse, la quantité est doublée.\n> Ce personnage et tous les alliés Symbiote Six obtiennent +100 % de drain de vie.\n\nL'attaque est inévitable et ne peut pas être bloquée.","operations":[{"abilityId":"abl_abb6d92cc0d204cc","abilityType":"ultimate","actionOrder":0,"chance":null,"characterId":"SymbioteQuicksilver","conditions":["Contexte : Attaque"],"effect":{"label":"Immunité","mechanicId":"debuff-block","resolved":true,"sourceName":"DebuffBlock"},"evidence":"normalized","id":"op_730c954c3ac6bdfb","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["debuff-block"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":"allié · cible aléatoire · jusqu’à 10","trigger":null},{"abilityId":"abl_abb6d92cc0d204cc","abilityType":"ultimate","actionOrder":6,"chance":100,"characterId":"SymbioteQuicksilver","conditions":["Contexte : Attaque"],"effect":{"label":"Silence","mechanicId":"silence","resolved":true,"sourceName":"Silence"},"evidence":"normalized","id":"op_d177411bb572a2cf","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["silence"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":null,"trigger":null},{"abilityId":"abl_abb6d92cc0d204cc","abilityType":"ultimate","actionOrder":6,"chance":100,"characterId":"SymbioteQuicksilver","conditions":["Contexte : Attaque"],"effect":{"label":"Ralentissement","mechanicId":"slow","resolved":true,"sourceName":"Slow"},"evidence":"normalized","id":"op_ebdd53ed6e3cc403","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["slow"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","s