e gagne +100 % de dégâts par Défense réduite sur la cible principale.\n\nEn attaque de guerre :\n> Donne +2 Chargé à soi et aux alliés Chiens de guerre jusqu'à un maximum de 10.\n> Pour chaque ennemi Chargé ou ressuscité une fois, donne +1 Chargé à soi et aux alliés Chiens de guerre jusqu'à un maximum de 10.\n> Donne Indestructible + Déviation + Évitement.\n> Si la cible principale a Sauvegarde, donne Sauvegarde pendant 2 tours à soi et aux alliés Chiens de guerre.\n\nTransmet tous les effets bénéfiques, sauf Sauvegarde, Furtivité et Provocation, à soi et aux alliés Chiens de guerre et Starbrand.\n\nL'attaque est inévitable et ne peut pas être bloquée.","operations":[{"abilityId":"abl_f2704c834d44d8e1","abilityType":"ultimate","actionOrder":2,"chance":100,"characterId":"BlackPantherBC","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Sauvegarde","mechanicId":"locked-buff","resolved":true,"sourceName":"LockedBuff"},"evidence":"normalized","id":"op_5c8c31d3948e2180","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["locked-buff"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":"allié · cible aléatoire · jusqu’à 10","trigger":null},{"abilityId":"abl_f2704c834d44d8e1","abilityType":"ultimate","actionOrder":11,"chance":100,"characterId":"BlackPantherBC","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Évitement","mechanicId":"evade","resolved":true,"sourceName":"Evade"},"evidence":"normalized","id":"op_1eec1084f3d81a6f","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["evade"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1},{"key":"applyCount","label":"Nombre d’applications","unit":null,"value":3}],"modes":["Guerre"],"scope":"Cible