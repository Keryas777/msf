t gagner des bonus de dégâts et de focalisation que par des effets bénéfiques.\n> Les héros ennemis peuvent seulement gagner une résistance et de la vitesse supplémentaires à travers des effets bénéfiques.\n\nDans l’Épreuve, si ce personnage a au moins 3 alliés Maudits :\n> Les ennemis ne peuvent pas obtenir Vitesse augmentée, Chargé, ou Attaque augmentée.\n> Les héros ennemis ne peuvent pas obtenir Provocation.\n> Les ennemis ne peuvent pas faire d’appui.\n> La jauge de vitesse des ennemis ne peut pas se remplir (cela ne s'applique pas au gain normal de jauge de vitesse).\n> La vitesse de soi et des alliés ne peut être réduite que par Ralentissement.","operations":[{"abilityId":"abl_c8959b62691c319b","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"TheHood","conditions":[],"effect":{"label":"Blocage de soins","mechanicId":"heal-block","resolved":true,"sourceName":"HealBlock"},"evidence":"normalized","id":"op_32de718121830cf0","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["heal-block"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"ennemi","trigger":"Lors d’une attaque réussie"},{"abilityId":"abl_c8959b62691c319b","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"TheHood","conditions":[],"effect":{"label":"Saignement","mechanicId":"do-t","resolved":true,"sourceName":"DoT"},"evidence":"normalized","id":"op_7b4ef05b65473c71","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["do-t"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"ennemi","trigger":"Lors d’une attaque réussie"}],"parentAbilityId":null,"presentationStatus":"official","relatedMechanics":[{"id":"charged","