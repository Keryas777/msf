périssable non invoqué. Puis retire 5 fois Chargé.\n\nIl n'est pas possible d'appliquer Étourdissement à ce personnage.\nDonne +100 % de résistance, et +100 % aux alliés Impérissables.\nDonne +30 % de dégâts par Chargé.\n\nEn attaque de guerre :\n> À l'apparition, donne 2 fois Chargé.\n> Donne +10 % de drain de vie par Chargé.\n> Avec au moins 50 % de vie, réduit la résistance des ennemis de 75 %.\n> Avec au moins 50 % de vie, empêche les ennemis d'obtenir Vitesse augmentée.","operations":[{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"ZombieJuggernaut","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Chargé","mechanicId":"charged","resolved":true,"sourceName":"Charged"},"evidence":"normalized","id":"op_2e10161c9e1fef0a","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["charged"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"ZombieJuggernaut","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Provocation","mechanicId":"taunt","resolved":true,"sourceName":"Taunt"},"evidence":"normalized","id":"op_503441426c92a970","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["taunt"],"metrics":[{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc","target":"allié","trigger":"Au début du combat"},{"abilityId":"abl_a5d5ba153bdb0412","abilityType":"passive","actionOrder":1,"chance":null,"characterId":"ZombieJuggernaut","conditions":[],"effect":{"label":"Provocation","mechanicId":"taunt","resolved":true,"sourceName":"Taunt"},"evidence":"normalized","id":"op_6cfc600b1473ff20","kind":"effect_ap