ge 500 % de dégâts puis retire tous les Chargés.\n\nEn cas de coup critique par soi-même ou un allié Nouveau mutant, supprime Blocage de soins de l’allié Nouveau mutant ayant perdu le plus de vie et le soigne de 5 % de sa vie max.\n\nLa première fois que la vie de ce personnage ou d’un allié Nouveau mutant tombe en dessous de 40 %, soigne cet allié de 30 % de sa vie max. et réduit la durée d’Obstruction de 2 sur ce personnage, applique également 2 Indestructible et 2 Évitement.\nSi la vie de ce personnage tombe à nouveau en dessous de 40 %, soigne ce personnage de 15 % et applique 1 Indestructible et 1 Évitement à la place.\n\nDonne +20 % de drain de vie. Donne +20 % de drain de vie aux alliés X-Men.","operations":[{"abilityId":"abl_76983d88ff8a8c3d","abilityType":"passive","actionOrder":1,"chance":100,"characterId":"Magik","conditions":[],"effect":{"label":"Évitement","mechanicId":"evade","resolved":true,"sourceName":"Evade"},"evidence":"normalized","id":"op_21df5ce2ba516352","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["evade"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":null,"trigger":"Sous un seuil de vie"},{"abilityId":"abl_76983d88ff8a8c3d","abilityType":"passive","actionOrder":1,"chance":100,"characterId":"Magik","conditions":[],"effect":{"label":"Dernier souffle","mechanicId":"deathproof","resolved":true,"sourceName":"Deathproof"},"evidence":"normalized","id":"op_2beedfaa7752b906","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["deathproof"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":null,"trigger":"Sous un seuil de vie"},{"abilityId":"abl_76983d88ff8a8c3d","abilityType":"passive","act