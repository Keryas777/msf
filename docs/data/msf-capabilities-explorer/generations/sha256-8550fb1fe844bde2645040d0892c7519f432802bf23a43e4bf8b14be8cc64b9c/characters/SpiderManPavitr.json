alentissement.\n\nSupprime Ralentissement de soi-même et de tous les alliés.\nApplique +2 Vitesse augmentée, jusqu'à un maximum de 5, à soi-même et à tous les alliés Héros.\nPour chaque ennemis avec Ralentissement, donne à soi-même et à tous les alliés héros du Spider-Verse une Barrière de 5 % de la vie max. de ce personnage.\n\nL'attaque ne peut pas être contrée.","operations":[{"abilityId":"abl_3401f47fab51e0a7","abilityType":"ultimate","actionOrder":1,"chance":100,"characterId":"SpiderManPavitr","conditions":[],"effect":{"label":"Défense réduite","mechanicId":"defense-down","resolved":true,"sourceName":"DefenseDown"},"evidence":"normalized","id":"op_7fb759534442f55c","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["defense-down"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":null,"trigger":null},{"abilityId":"abl_3401f47fab51e0a7","abilityType":"ultimate","actionOrder":5,"chance":100,"characterId":"SpiderManPavitr","conditions":[],"effect":{"label":"Ralentissement","mechanicId":"slow","resolved":true,"sourceName":"Slow"},"evidence":"normalized","id":"op_31553d2b905cc6d1","kind":"effect_remove","kindLabel":"Retire","mechanicIds":["slow"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":1000}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_remove","target":"allié · cible aléatoire · jusqu’à 10","trigger":null},{"abilityId":"abl_3401f47fab51e0a7","abilityType":"ultimate","actionOrder":2,"chance":100,"characterId":"SpiderManPavitr","conditions":[],"effect":{"label":"Ralentissement","mechanicId":"slow","resolved":true,"sourceName":"Slow"},"evidence":"normalized","id":"op_e1e27e203bb62cbe","kind":"effect_duration_modify","kindLabel":"Modifie la durée","mechani