ite que par Ralentissement.","operations":[{"abilityId":"abl_f2a80425fb32185d","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"Morph","conditions":["Condition d’exclusion présente"],"effect":{"label":"Invisible Non Binary","mechanicId":"invisible-non-binary","resolved":true,"sourceName":"InvisibleNonBinary"},"evidence":"normalized","id":"op_70ca0794ecfcb894","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["invisible-non-binary"],"metrics":[],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"À la fin de son tour"},{"abilityId":"abl_f2a80425fb32185d","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Morph","conditions":["Condition d’exclusion présente"],"effect":{"label":"Provocation","mechanicId":"taunt","resolved":true,"sourceName":"Taunt"},"evidence":"normalized","id":"op_8271acda020ea894","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["taunt"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":2}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"ennemi · cible aléatoire · jusqu’à 10","trigger":"À l’entrée dans un état"},{"abilityId":"abl_f2a80425fb32185d","abilityType":"passive","actionOrder":0,"chance":100,"characterId":"Morph","conditions":["Condition structurée supplémentaire"],"effect":{"label":"Darkness","mechanicId":"darkness","resolved":true,"sourceName":"Darkness"},"evidence":"normalized","id":"op_8a04e938299082c6","kind":"effect_flip","kindLabel":"Retourne","mechanicIds":["darkness"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"selectionCount","label":"Nombre de cibles sélectionnées","unit":null,"value":1000}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_flip","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_f2a80425fb32185d","abilityType":"passive","actionOrde