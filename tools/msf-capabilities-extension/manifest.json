{
  "manifest_version": 3,
  "name": "LoSP — Données de capacités MSF",
  "description": "Met à jour les données officielles de capacités MSF depuis le catalogue local du jeu.",
  "version": "0.2.0",
  "minimum_chrome_version": "95",
  "permissions": [
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://webplayable.m3.scopelypv.com/*",
    "https://losp-msf-capabilities.deliriousfan7.workers.dev/*"
  ],
  "action": {
    "default_title": "Données de capacités MSF",
    "default_popup": "popup.html"
  }
}
