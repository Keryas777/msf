ère 1 fois Furtivité de soi à l'allié Chien de guerre ayant perdu le plus de vie.\n\nDonne +30 % de dégâts.\nEn attaque de guerre, applique aux alliés Chiens de guerre +30 % de dégâts.\nDonne +50 % de focalisation.\nEn attaque de guerre, applique aux alliés Chiens de guerre +50 % de focalisation.","operations":[{"abilityId":"abl_58491fd3e799d737","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"Nakia","conditions":[],"effect":{"label":"Furtivité","mechanicId":"stealth","resolved":true,"sourceName":"Stealth"},"evidence":"normalized","id":"op_3cfc0e029e90fffe","kind":"effect_duration_modify","kindLabel":"Modifie la durée","mechanicIds":["stealth"],"metrics":[{"key":"delta","label":"Variation de durée","unit":null,"value":1},{"key":"maxDuration","label":"Durée maximale","unit":null,"value":5}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc_duration","target":"allié","trigger":"Lorsqu’un effet bénéfique est reçu"},{"abilityId":"abl_58491fd3e799d737","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"Nakia","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Furtivité","mechanicId":"stealth","resolved":true,"sourceName":"Stealth"},"evidence":"normalized","id":"op_735022e0f053b7f6","kind":"effect_duration_modify","kindLabel":"Modifie la durée","mechanicIds":["stealth"],"metrics":[{"key":"delta","label":"Variation de durée","unit":null,"value":-1}],"modes":["Guerre"],"scope":"Cible de l’action","sides":["Attaque"],"sourceType":"proc_duration","target":"allié","trigger":"Sous un seuil de vie"},{"abilityId":"abl_58491fd3e799d737","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"Nakia","conditions":["Contexte : Attaque","Mode : Guerre"],"effect":{"label":"Chargé","mechanicId":"charged","resolved":true,"sourceName":"Charged"},"evidence":"normalized","id":"op_a8e72fded0d05d22","kind":"effect_duration_modify","kindLabel":"Modifie la durée","mechanicIds":["charged"],"metrics":[{"key