ityType":"passive","chance":null,"characterId":"KamalaKhan","conditions":[],"evidence":"preserved_uninterpreted","id":"act_b10bf28878d16638","kind":"detected","kindLabel":"Actions détectées","label":"Soin","mechanicId":"action-heal","metrics":[],"modes":[],"sides":[],"sourceType":"heal","target":null,"trigger":null}],"baseType":"passive","characterId":"KamalaKhan","energy":null,"iconUrl":"https://assets.marvelstrikeforce.com/imgs/ICON_ABILITY_KAMALAKHAN_PASSIVE_71f9bc4c.png","id":"abl_dd7ea997c065baa0","isEmpowered":false,"maxLevel":"5","mechanicsStatus":"available","mentions":[{"abilityId":"abl_dd7ea997c065baa0","abilityType":"passive","chance":null,"characterId":"KamalaKhan","conditions":[],"evidence":"official_text_only","excerpt":"Lui supprime Provocation et applique 2 fois Régénération (Sauvegarde empêche Provocation d'être supprimée).","id":"txt_b8be0b1a0e5716a6","kind":"mention","kindLabel":"Mentions","mechanicId":"locked-buff","metrics":[],"modes":[],"sides":[],"target":null,"term":"Sauvegarde","trigger":null}],"name":"Super fan","officialText":"À l'apparition :\n> Remplit la jauge de vitesse de 10 % + 10 % par allié Défenseur secret.\n> Donne à soi et aux alliés Défenseurs secrets une Barrière de 20 % de la vie max. de ce personnage.\n> Donne Défense augmentée à soi et aux alliés Défenseurs secrets.\n\nÀ chaque attaque subie, donne 1 fois Chargé.\nÀ n'importe quel tour, avec au moins 5 fois Chargé, donne une Barrière de 20 % de vie, rend 20 % de vie puis retire 5 fois Chargé.\n\nAu gain de Surpuissant d'un ennemi, rend 20 % de vie et donne une Barrière de 20 % de vie et Provocation.\n\nQuand soi ou un allié Défenseur secret passe sous 30 % de vie la première fois :\n> Lui supprime Obstruction et applique Indestructible et Furtivité.\n> Lui supprime Provocation et applique 2 fois Régénération (Sauvegarde empêche Provocation d'être supprimée).\n\nDonne +50 % d'armure et +50 % aux alliés Défenseurs secrets.\nDonne +15 % de Barrière max. et +15 % aux alliés Défenseurs secrets.\nEn arène, donne +50 % de vie max.","operations":[{"abilityId":"abl_dd7ea997c065baa0","abilityType":"passive","actionOrder":0,"chance":null,"characterId":"KamalaKhan","conditions":[],"effect":{"label":"Binary","mechanicId":"binary","resolved":true,"sourceName":"Binary"},"evidence":"normalized","id":"op_4227d4cea262a61c","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["binary"],"metrics":[],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":"allié","trigger":"À chaque tour"},{"abilityId":"abl_dd7ea997c065baa0","abilityType":"passive","actionOrder":1,"chance":100,"characterId":"KamalaKhan","conditions":[],"effect":{"label":"Dernier souffle","mechanicId":"deathproof","resolved":true,"sourceName":"Deathproof"},"evidence":"normalized","id":"op_16b2fe2a6da32a8e","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["deathproof"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":null,"trigger":"Sous un seuil de vie"},{"abilityId":"abl_dd7ea997c065baa0","abilityType":"passive","actionOrder":1,"chance":100,"characterId":"KamalaKhan","conditions":[],"effect":{"label":"Furtivité","mechanicId":"stealth","resolved":true,"sourceName":"Stealth"},"evidence":"normalized","id":"op_7f4c7390d9821348","kind":"effect_apply","kindLabel":"Applique","mechanicIds":["stealth"],"metrics":[{"key":"chancePct","label":"Chance","unit":"%","value":100},{"key":"useCount","label":"Quantité indiquée","unit":null,"value":1}],"modes":[],"scope":"Cible de l’action","sides":[],"sourceType":"proc","target":null,"trigger":"Sous un seuil de vie"},{"abilityId":"abl_dd7ea997c065baa0","abilityType":"passive","actionOrder":2,"chance":null,"characterId":"KamalaKhan","conditions":[],"effect":{"label":"Provocation","mechanicId":"taunt","resolved":true,"sourceName":"Taunt"},"evidence":"n